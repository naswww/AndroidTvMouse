<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面 V2.1：三列单屏，文案全部走 string 资源，支持中英文 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_padding">

        <!-- ===== 页头 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/ver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_marginEnd="@dimen/space_3"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_caption" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/header_hint"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/header_hint2"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/adb"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/chip_height"
                android:layout_marginEnd="@dimen/space_2"
                android:gravity="center"
                android:paddingStart="@dimen/space_3"
                android:paddingEnd="@dimen/space_3"
                android:background="@drawable/chip_bg"
                android:text="@string/adb_checking"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/chip_height"
                android:gravity="center"
                android:paddingStart="@dimen/space_3"
                android:paddingEnd="@dimen/space_3"
                android:background="@drawable/chip_bg"
                android:text="@string/state_remote"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <!-- ===== 三列主体 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="440dp"
            android:layout_marginTop="@dimen/space_3"
            android:orientation="horizontal">

            <!-- 第 1 列：控制 + 参数 + 地址 + 关于 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.15"
                android:layout_marginEnd="@dimen/space_3"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_control"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_section"
                    android:letterSpacing="0.1" />

                <Button
                    android:id="@+id/btnTakeover"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/btn_primary_bg"
                    android:text="@string/btn_start"
                    android:textAllCaps="false"
                    android:textColor="@color/accent"
                    android:textSize="@dimen/text_body"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnRelease"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/btn_bg"
                    android:text="@string/btn_release"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    android:stateListAnimator="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/section_params"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_section"
                    android:letterSpacing="0.1" />

                <LinearLayout
                    android:id="@+id/paramList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/section_addr"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_section"
                    android:letterSpacing="0.1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/addr"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/btn_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:gravity="center_vertical"
                        android:inputType="text"
                        android:singleLine="true"
                        android:hint="@string/addr_hint"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="13sp"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:cursorVisible="false" />

                    <ImageButton
                        android:id="@+id/btnEditAddr"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/btn_bg"
                        android:src="@drawable/ic_edit"
                        android:scaleType="centerInside"
                        android:padding="8dp"
                        android:contentDescription="@string/addr_edit"
                        android:focusable="false"
                        android:clickable="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnLang"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/btn_bg"
                        android:text="@string/lang_auto"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body"
                        android:stateListAnimator="@null" />

                    <Button
                        android:id="@+id/btnAbout"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_2"
                        android:background="@drawable/btn_bg"
                        android:text="@string/btn_about"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body"
                        android:stateListAnimator="@null" />
                </LinearLayout>
            </LinearLayout>

            <!-- 第 2 列：遥控器示意图 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_3"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/section_remote"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_section"
                    android:letterSpacing="0.1" />

                <com.tv.remotemouse.v2.RemoteView
                    android:id="@+id/remote"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- 第 3 列：按键映射 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_map"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_section"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_2"
                        android:text="@string/map_hint"
                        android:textColor="@color/text_muted"
                        android:textSize="@dimen/text_caption"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mapList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/space_2"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/btn_bg"
                    android:text="@string/back_right"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnRestore"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/btn_bg"
                    android:text="@string/btn_restore"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
